<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.indogaro.companion">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="Indogaro Controller"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <!-- Quick Settings Tile untuk Status Bar Android -->
        <service
            android:name=".IndogaroTileService"
            android:icon="@android:drawable/stat_notify_sync"
            android:label="Indogaro Carrier"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
